# Neon PostgreSQL connection string (use the pooled or direct string from the Neon console)
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Random 32+ char secret used to sign session cookies. Generate: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: YouTube Data API v3 key – enables YouTube search/embed playback (huge track variety)
YOUTUBE_API_KEY=""

# Optional: Jamendo client id – enables full-length Creative Commons music streams
JAMENDO_CLIENT_ID=""
