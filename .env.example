# --- Required -----------------------------------------------------------
# Neon (or any PostgreSQL) connection string. Use the *pooled* string from the Neon console.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Random secret used to sign session cookies (min. 32 chars). Generate with:
#   openssl rand -base64 48
AUTH_SECRET=""

# --- Optional audio sources ---------------------------------------------
# YouTube Data API v3 key. Enables YouTube search + embedded playback.
YOUTUBE_API_KEY=""
# Jamendo client id (free, https://devportal.jamendo.com). Enables Jamendo tracks.
JAMENDO_CLIENT_ID=""

# --- Optional ------------------------------------------------------------
# Force the database driver: "neon" (HTTP, serverless) or "pg" (TCP, local Postgres).
# Default: "neon" when the host ends in neon.tech, otherwise "pg".
# DB_DRIVER=""
